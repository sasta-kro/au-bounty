# AU Bounty VM deployment env (template, committed WITHOUT secret values).
#
# The real copy lives on the VM at ~/apps/au-bounty/.env.azure (chmod 600,
# never committed) and is consumed by:
#   docker compose -f docker-compose.azure.yml --env-file .env.azure up -d
#
# Runtime secrets (JWT, Entra client secret, Resend, Google Maps, Google
# Translate) are pulled from Azure Key Vault at boot while SECRETS_PROVIDER
# is keyvault. This file holds only what the vault does not.

# --- vault wiring -------------------------------------------------------------
SECRETS_PROVIDER=keyvault
KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Entra ID (app registration "AuBounty") -----------------------------------
ENTRA_TENANT_ID=c1f3dc23-b7f8-48d3-9b5d-2b12f158f01f
ENTRA_CLIENT_ID=90352943-03c7-4da8-9e49-26820dfb012a

# --- admin console seeding (read by the entrypoint BEFORE the vault loader) ---
ADMIN_SEED_EMAILS=
ADMIN_SEED_PASSWORD=
# 1 for one boot applies the password to already-seeded admins. Set back to 0.
ADMIN_SEED_RESET_PASSWORD=0

# --- Backblaze B2 storage (attachments) ----------------------------------------
# Bucket is private. Its CORS rule must allow PUT and GET from the site origin
# (set once via the S3 API or the b2 CLI; the web console has no JSON editor).
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_PUBLIC_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=au-bounty-s3-bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- optional integrations (empty = graceful fallback) -------------------------
MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_FROM=
GOOGLE_MAPS_KEY=
GOOGLE_TRANSLATE_KEY=
