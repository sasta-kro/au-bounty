# AU Bounty VM deployment env (template, committed WITHOUT secret values).
#
# On the VM this file lives at ~/apps/au-bounty/.env.azure next to
# docker-compose.azure.yml, chmod 600, and is consumed by:
#   docker compose -f docker-compose.azure.yml --env-file .env.azure up -d
#
# Everything not listed here (database URL, MinIO endpoint) is set
# directly in docker-compose.azure.yml because those values resolve inside the
# compose network and never change between deployments.

# --- Entra ID (app registration "AuBounty") ----------------------------------
# The secret VALUE is only visible in Entra > Certificates & secrets at
# creation time. Never commit the real value; paste it into the VM copy only.
ENTRA_TENANT_ID=c1f3dc23-b7f8-48d3-9b5d-2b12f158f01f
ENTRA_CLIENT_ID=90352943-03c7-4da8-9e49-26820dfb012a
ENTRA_CLIENT_SECRET=paste-the-ms7-secret-value-here

# --- signing key (generate per deployment, never commit) ---------------------
#   openssl rand -base64 48     -> JWT_SECRET
JWT_SECRET=generate-per-deployment

# --- optional integrations (empty = graceful fallback) ------------------------
RESEND_API_KEY=
MAIL_FROM=
GOOGLE_MAPS_KEY=
GOOGLE_TRANSLATE_KEY=
